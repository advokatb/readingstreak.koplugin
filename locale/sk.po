msgstr "Sivá"

msgid "Automatically track reading"
msgstr "Automaticky sledovať čítanie"

msgid "Tracking"
msgstr "Sledovanie"

msgid "Reset All Data"
msgstr "Vynulovať všetky údaje"

msgid "Are you sure you want to reset all reading streak data?"
msgstr "Naozaj chcete vynulovať všetky údaje o čitateľskej sérii?"

msgid "Reset"
msgstr "Vynulovať"

msgid "1 day"
msgstr "1 deň"

msgid "%1 days"
msgstr "%1 dní"

