msgid "Reset All Data"
msgstr "Vynulovat všechna data"

msgid "Are you sure you want to reset all reading streak data?"
msgstr "Opravdu chcete vynulovat všechna data čtenářské série?"

msgid "Reset"
msgstr "Vynulovat"

