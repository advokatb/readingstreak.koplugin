msgstr "%1 nap"

msgid "1 week"
msgstr "1 hét"

msgid "%1 weeks"
msgstr "%1 hét"

msgid "%1 pages"
msgstr "%1 oldal"

msgid "%1 minutes"
msgstr "%1 perc"

msgid "%1 days read out of %2"
msgstr "%1 nap a %2-ból/ből"

msgid "Data Management"
msgstr "Adatok kezelése"

msgid "Daily page target: %1"
msgstr "Napi oldal cél: %1"

msgid "Daily time target: %1"
msgstr "Napi idő cél: %1"

msgid "Daily Page Target"
msgstr "Napi oldal cél"

msgid "Daily Time Target (minutes)"
msgstr "Napi idő cél (perc)"

msgid "Off"
msgstr "Ki"

msgid "Import from Statistics"
msgstr "Importálás statisztikából"

msgid "Statistics database not found."
msgstr "Statisztika adatbázis nem található."

msgid "No reading statistics found in database."
msgstr "Nem található olvasási statisztika az adatbázisban."

msgid "No new reading statistics found in database."
msgstr "Nem található új olvasási statisztika."

msgid "No days met the configured daily targets."
msgstr "Egyetlen nap sem érte el a beállított napi célokat."

msgid "Imported %1 reading days from statistics database."
msgstr "%1 napnyi olvasási statisztika importálva."

msgid "Imported %1 reading days; skipped %2 days below daily targets."
msgstr "%1 napnyi olvasási statisztika importálva, kihagyva %2 nap cél alatt teljesítve."

msgid "Error importing statistics: %1"
msgstr "Hiba statisztika importáláskor: %1"

msgid "Error showing calendar: %1"
msgstr "Hiba naptár megjelenítésekor: %1"

msgid "Streak Goal: %1 days"
msgstr "Széria cél: %1 nap"

msgid "Calendar streak display: %1"
msgstr "Naptárnézet: %1"

