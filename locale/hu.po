msgid "Reading Streak"
msgstr "Olvasási Széria"

msgid "Track your daily and weekly reading streaks similar to Kindle Streak. View calendar, set goals, and celebrate milestones."
msgstr "Kövesd nyomon a napi és heti olvasási szériádat, hasonlóan a Kindle Streak-hez. Tekintsd meg naptárban, állíts be célokat és ünnepeld a mérföldköveket."

msgid "Congratulations! You've reached your streak goal of %1 days!"
msgstr "Gratulálok! Elérted a(z) %1 napos széria célodat!"

msgid "Congratulations! You've met today's streak target!"
msgstr "Gratulálok! Elérted a mai széria célt!"

msgid "Never"
msgstr "Soha"

msgid "Reading streak has been reset!"
msgstr "Olvasási széria kinullázva!"

msgid "View Streak"
msgstr "Széria megtekintése"

msgid "Calendar View"
msgstr "Naptár nézet"

msgid "Settings"
msgstr "Beállíítások"

msgid "Goals"
msgstr "Célok"

msgid "Streak Goal"
msgstr "Széria cél"

msgid "Show streak notifications"
msgstr "Széria értesítések mutatása"

msgid "Use toast notifications"
msgstr "Toast értesítések használata"

msgid "Automatically track reading"
msgstr "Olvasás automatikus követése"

msgid "Tracking"
msgstr "Követés"

msgid "Reset All Data"
msgstr "Minden adat kinullázása"

msgid "Are you sure you want to reset all reading streak data?"
msgstr "Biztos vagy benne, hogy minden olvasási széria adatot ki szeretnél nullázni?"

msgid "Reset"
msgstr "Kinullázás"

msgid "1 day"
msgstr "1 nap"

