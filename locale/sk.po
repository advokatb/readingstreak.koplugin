msgstr "Importovať zo štatistík"

msgid "Statistics database not found."
msgstr "Databáza štatistík sa nenašla."

msgid "No reading statistics found in database."
msgstr "V databáze sa nenašli žiadne štatistiky čítania."

msgid "No new reading statistics found in database."
msgstr "V databáze sa nenašli žiadne nové štatistiky čítania."

msgid "No days met the configured daily targets."
msgstr "Žiadny deň nesplnil nastavené denné ciele."

msgid "Imported %1 reading days from statistics database."
msgstr "Z databázy štatistík bolo importovaných %1 dní čítania."

msgid "Imported %1 reading days; skipped %2 days below daily targets."
msgstr "Importovaných %1 dní čítania; preskočených %2 dní pod dennými cieľmi."

msgid "Error importing statistics: %1"
msgstr "Chyba pri importe štatistík: %1"

msgid "Error showing calendar: %1"
msgstr "Chyba pri zobrazení kalendára: %1"

